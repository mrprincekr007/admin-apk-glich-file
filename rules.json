{
  "rules": {
    "siteSettings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'REPLACE_ADMIN_EMAIL'"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'REPLACE_ADMIN_EMAIL'"
    },
    "posts": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'REPLACE_ADMIN_EMAIL'"
    },
    "ActiveUserKeys": {
      ".read": true,
      ".write": true
    },
    "BannedDevices": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'REPLACE_ADMIN_EMAIL'"
    },
    "users": {
      ".read": true,
      ".write": "newData.exists()"
    }
  }
}
